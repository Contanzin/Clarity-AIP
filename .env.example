# App
APP_NAME=Clarity A.I.P
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://clarity_user:clarity_password@localhost:5432/clarity_aip
POSTGRES_DB=clarity_aip
POSTGRES_USER=clarity_user
POSTGRES_PASSWORD=clarity_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Superusuário do Postgres — usado APENAS por db/setup.ps1 / db/setup.sh para
# criar o banco e o usuário da aplicação acima. Nunca usado pela app em runtime.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=defina-na-instalacao-do-postgres

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Security / prototype toggles
SESSION_SECRET=change-me-in-production
ENABLE_GEMINI_PRIVACY_NOTICE=True

# Application settings
EMBEDDING_DIMENSION=768
MIN_CONFIDENCE_NO_WARNING=0.7

# Warning: the Gemini free tier may use requests to improve the model unless your contract explicitly forbids it.
# This prototype uses synthetic or anonymized data only. Do not use real Claro data without a paid tier and contractual guarantees.
